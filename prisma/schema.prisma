generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — advisory locks used by
  // `prisma migrate deploy` aren't reliable through Neon's PgBouncer pooler.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ServiceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model VpnService {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  logo    String @default("🛡")

  websiteUrl   String
  referralUrl  String?

  // Заявленные (не измеренные автоматически) характеристики от провайдера.
  priceFrom        String
  priceMonthlyUsd  Float?
  claimedSpeedMbps Int?
  freeOption       String?
  rating           Float?

  platforms   String[]
  tags        String[]
  description String

  // Поля ниже обновляются автоматически фоновой проверкой (см. scripts/check-services.ts).
  status        ServiceStatus @default(UNKNOWN)
  latencyMs     Int?
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PriceReport {
  id        String   @id @default(cuid())
  serviceId String
  note      String
  createdAt DateTime @default(now())

  @@index([serviceId])
}

/// One row per automated check run, so uptime can be shown as a real
/// history instead of just the single latest status.
model StatusCheck {
  id        String        @id @default(cuid())
  serviceId String
  status    ServiceStatus
  latencyMs Int?
  checkedAt DateTime      @default(now())

  @@index([serviceId, checkedAt])
}

/// User-submitted reviews on a VPN's catalog page. Anonymous — no account
/// system — so `authorName` is free text, not tied to any identity.
model Review {
  id        String   @id @default(cuid())
  serviceId String

  authorName String
  text       String

  stars             Int // 1-5 overall rating
  speedRating       Int // 1-10
  reliabilityRating Int // 1-10
  valueRating       Int // 1-10 — соотношение цена/качество

  /// Salted hash of the submitter's IP — used only for rate-limiting new
  /// submissions, never displayed or linkable back to a real address.
  ipHash String?

  createdAt DateTime @default(now())

  @@index([serviceId, createdAt])
}
