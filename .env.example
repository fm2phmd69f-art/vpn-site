# Postgres connection string.
# Local dev: run `docker compose up -d` (uses docker-compose.yml) and use the line below as-is.
# Production: point this at your hosted Postgres (Neon, Supabase, Vercel Postgres, RDS, etc.)
DATABASE_URL="postgresql://vpn:vpn@localhost:5432/vpn_site?schema=public"

# Shared secret required in the `x-cron-secret` header to call POST /api/cron/check.
CRON_SECRET="change-me"
